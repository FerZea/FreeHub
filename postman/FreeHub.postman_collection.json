{
  "info": {
    "name": "FreeHub - Tercera entrega",
    "description": "Consulta pública de publicaciones guardadas en MongoDB. Esta etapa solo implementa GET /api/resources.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8082", "type": "string" }
  ],
  "item": [
    {
      "name": "Consultar publicaciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/resources",
        "description": "Devuelve data con las publicaciones más recientes primero. No requiere body ni token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consulta correcta: 200 OK', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('La respuesta contiene un arreglo data', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('array');",
              "});",
              "pm.test('Las publicaciones tienen los campos principales', () => {",
              "  for (const resource of pm.response.json().data) {",
              "    pm.expect(resource).to.have.all.keys('_id', 'title', 'url', 'description', 'category', 'resourceType', 'tags', 'imageUrl', 'author', 'createdAt');",
              "    pm.expect(resource.author.name).to.be.a('string');",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
