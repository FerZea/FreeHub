{
  "name": "freehub-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && npm start\"",
    "seed": "npm run build && node dist/database/seed.js",
    "test": "npm run build && node --test test/api.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dotenv": "18.0.10",
    "express": "4.22.3",
    "mongoose": "9.12.1"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "nodemon": "3.1.11",
    "typescript": "5.8.3"
  }
}
